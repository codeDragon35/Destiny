# Local Postgres runs on 5433 to avoid colliding with an existing 5432 instance.
DATABASE_URL=postgresql://destiny:destiny@localhost:5433/destiny
REDIS_URL=redis://localhost:6380

# Optional: Google Places API key (enable "Places API (New)" in Google Cloud).
# Without it, pages render deterministic gradients instead of photos.
GOOGLE_PLACES_API_KEY=
