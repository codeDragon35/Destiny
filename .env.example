# Local Postgres runs on 5433 to avoid colliding with an existing 5432 instance.
DATABASE_URL=postgresql://destiny:destiny@localhost:5433/destiny
REDIS_URL=redis://localhost:6380

# Optional: Google Places API key (enable "Places API (New)" in Google Cloud).
# Without it, pages render deterministic gradients instead of photos.
GOOGLE_PLACES_API_KEY=

# Required for Auth.js sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional SMTP for magic-link emails. Without it the sign-in link is
# printed to the server console, which is enough for local development.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Destiny <noreply@destiny.local>"
